#!/bin/sh
set -eu

swiftformat=${SWIFTFORMAT:-mint run swiftformat}
swiftlint=${SWIFTLINT:-mint run swiftlint}

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

if [ -z "$staged" ]; then
    exit 0
fi

if ! $swiftformat --lint $staged || ! $swiftlint lint --strict --quiet $staged; then
    echo "" >&2
    echo "整形か lint に違反しているのでコミットしませんでした。make format で直してからステージし直してください。" >&2
    exit 1
fi
